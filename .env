# Ports shared by compose.yaml and the Makefile, which both read this file. Tracked, so never put a
# secret here. Git ignores .env.local and every other .env.* file, and nothing reads them yet.
# Form: blank lines, # comment lines, and NAME=value lines, once per name. NAME is capital letters,
# digits and underscores; the value is letters, digits and . _ : / - only. LF line endings. The
# Makefile stops on anything else.
FRA_API_PORT=8000
FRA_LLM_PORT=8080
